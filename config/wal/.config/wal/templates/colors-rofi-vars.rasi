/* Rofi palette, generated by pywal from ~/.config/wal/templates/colors-rofi-vars.rasi
 * Output: ~/.cache/wal/colors-rofi-vars.rasi (imported by rofi/colors.rasi; do not edit the output)
 * Doubled braces are literal: pywal renders templates with Python str.format. */
* {{
    background:     {background};
    background-alt: {color8}55;
    foreground:     {foreground};
    selected:       {color2};
    active:         {color4};
    urgent:         {color1};
}}
